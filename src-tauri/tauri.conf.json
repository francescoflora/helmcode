{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "helmcode",
  "version": "0.1.0",
  "identifier": "com.helmcode.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "helmcode",
        "width": 760,
        "height": 500,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#111315"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
