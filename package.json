{
  "name": "helmcode",
  "private": true,
  "version": "0.2.5",
  "description": "Editor desktop per Windows che unisce AI, codice e Git in un'unica interfaccia.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "test": "node --test scripts/*.test.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "bench:diff": "node scripts/diff-performance.mjs",
    "bench:backend": "node scripts/performance-backend.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "start": "tauri dev",
    "tauri:dev": "tauri dev",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs",
    "build:app": "tauri build --bundles nsis",
    "tauri:build": "tauri build --bundles nsis",
    "tauri:windows:build": "tauri-windows-bundle build --runner npm --regenerate-assets"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "style-mod": "^4.1.5"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.2.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-language-server": "^6.0.3",
    "vite": "^8.3.6"
  }
}
